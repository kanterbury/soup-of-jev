# Jev の呼び出し経路：direct（TypeSafe 直接 API、既定）か gateway（Vercel AI Gateway）
# gateway に切り替えるときは、その経路で評価（npm run eval -- --all）を回してから使う
JEV_PROVIDER=direct

# JEV_PROVIDER=direct のとき：TypeSafe 直接 API の鍵
TYPESAFE_API_KEY=

# JEV_PROVIDER=gateway のとき：Vercel AI Gateway の鍵
AI_GATEWAY_API_KEY=

# いいねの数の保存先（Upstash Redis）。Vercel Marketplace で追加すると入る
# 空のときはメモリで数える（開発用。サーバーを止めると消える）
KV_REST_API_URL=
KV_REST_API_TOKEN=

# アクセス解析（Google Analytics 4）の測定 ID（G-XXXXXXXXXX）。空のときは読み込まず、計測しない
# Vercel では Production にだけ設定する（開発・Preview では計測しない）
NEXT_PUBLIC_GA_MEASUREMENT_ID=
